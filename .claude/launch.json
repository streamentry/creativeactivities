{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "site-dev",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--dir",
        "site",
        "exec",
        "astro",
        "dev",
        "--port",
        "4321"
      ],
      "port": 4321
    },
    {
      "name": "site-workers",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--dir",
        "site",
        "exec",
        "wrangler",
        "dev",
        "--port",
        "8787",
        "--ip",
        "127.0.0.1"
      ],
      "port": 8787
    },
    {
      "name": "site-preview",
      "runtimeExecutable": "/bin/sh",
      "runtimeArgs": [
        "-c",
        "cd /Volumes/SANDISK-Data/creativeactivities/site && PATH=$HOME/.nvm/versions/node/v24.11.1/bin:$PATH $HOME/.local/bin/pnpm exec astro preview --port 4322 --host 127.0.0.1"
      ],
      "port": 4322
    }
  ]
}
