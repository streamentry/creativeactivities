{
  "$schema": "../node_modules/wrangler/config-schema.json",
  // Sends www.creativeactivities.org to the apex with a permanent redirect,
  // keeping the path and query. Nothing is logged or stored. It does not touch
  // dementiaactivities.games, which is a separate product.
  "name": "creative-activities-www-redirect",
  "main": "index.js",
  "compatibility_date": "2026-10-01",
  "routes": [{ "pattern": "www.creativeactivities.org", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": false }
}
