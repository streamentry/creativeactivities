---
import type { GetStaticPaths } from 'astro';
import SectionView from '../../../views/SectionView.astro';
import RetiredRedirect from '../../../components/RetiredRedirect.astro';
import { SECTIONS } from '../../../content.config';
import type { SectionKey } from '../../../lib/site';
import { TRANSLATED } from '../../../i18n/ui';
import { RETIRED_SECTIONS, isRetiredSection } from '../../../lib/retired-guides';

// A retired section (brain-health) keeps its address in every language as a redirect page.
export const getStaticPaths = (() =>
  TRANSLATED.flatMap((l) =>
    SECTIONS.map((section) => ({ params: { lang: l.prefix, section }, props: { section, lang: l.code } })),
  )) satisfies GetStaticPaths;

interface Props {
  section: SectionKey;
  lang: string;
}
const { section, lang } = Astro.props;
---
{isRetiredSection(section) ? <RetiredRedirect to={RETIRED_SECTIONS[section] as string} lang={lang} /> : <SectionView section={section} lang={lang} />}
