---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { PACKS } from '../data/packs';
import '../styles/activities.css';
import '../styles/studio-finder.css';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { breadcrumbs, itemList } from '../lib/schema';
import {
  ENERGY_CHOICES,
  SUPERVISION_CHOICES,
  SENSE_CHOICES,
  TALKING_CHOICES,
  GROUP_LABELS,
  MATERIAL_CHOICES,
  MESS_CHOICES,
  SETTING_LABELS,
  TIME_CHOICES,
  TYPE_LABELS,
  VARIATION_LABELS,
  glance,
} from '../lib/activities';

const hubs = (await getCollection('hubs')).sort((a, b) => a.data.title.localeCompare(b.data.title));
const activities = (await getCollection('activityCards')).sort((a, b) => a.data.name.localeCompare(b.data.name));
const crumbs = [{ href: '/activity/', label: 'Find an activity' }];
const title = 'Find an Activity to Do Together';
const description =
  'Free creative activities to start together today: crafts, painting, plants, music and stories, with setup time, materials, easier versions and a printable card.';
const types = Object.entries(TYPE_LABELS);
const settings = (['seated', 'bedside', 'outdoors'] as const).map((s) => [s, SETTING_LABELS[s]] as const);
const groups = Object.entries(GROUP_LABELS);
const easier = (kinds: { kind: string; text: string }[]) =>
  kinds.find((v) => v.kind === 'easier') ?? kinds.find((v) => v.kind === 'bedside') ?? kinds[0];
---
<BaseLayout title={title} description={description} image="/og/activities.png" jsonLd={[breadcrumbs(crumbs), itemList(title, activities.map((a) => ({ path: `/activity/${a.id}/`, name: a.data.name })))]}>
  <Breadcrumbs items={crumbs} />
  <div class="container">
    <header class="page-head">
      <p class="eyebrow">Find an activity</p>
      <h1>What would you like to do together?</h1>
      <p class="lede">
        Every activity here can start with everyday things, needs no account and comes with an easier version and a
        card to print. Choose as much or as little as you like below. “Any” is always fine.
      </p>
      {
        PACKS.map((p) => (
          <p>
            Want a few ready to go? <a href={`/activity/packs/${p.id}/`}>Print {p.title.split(':')[0].toLowerCase()}</a>, one card per page.
          </p>
        ))
      }
    </header>

    <section class="finder-saved" id="saved-activities" aria-labelledby="saved-title" hidden>
      <h2 id="saved-title">Saved activities</h2>
      <p class="muted">Kept on this device only. Clearing this site's data removes them.</p>
      <ul class="activity-list" id="saved-list"></ul>
    </section>

    <form class="finder" id="finder" aria-label="Find an activity">
      <fieldset>
        <legend>How much time do you have?</legend>
        {
          TIME_CHOICES.map((c) => (
            <label class="choice">
              <input type="radio" name="time" value={c.value} checked={c.value === 'any'} />
              <span>{c.label}</span>
            </label>
          ))
        }
      </fieldset>
      <fieldset>
        <legend>What do you have to hand?</legend>
        {
          MATERIAL_CHOICES.map((c) => (
            <label class="choice">
              <input type="radio" name="materials" value={c.value} checked={c.value === 'any'} />
              <span>{c.label}</span>
            </label>
          ))
        }
      </fieldset>
      <fieldset>
        <legend>What kind of activity?</legend>
        <label class="choice">
          <input type="radio" name="type" value="any" checked />
          <span>Any</span>
        </label>
        {
          types.map(([value, label]) => (
            <label class="choice">
              <input type="radio" name="type" value={value} />
              <span>{label}</span>
            </label>
          ))
        }
      </fieldset>
      <details class="finder__more">
        <summary>More ways to fit the moment (optional)</summary>
        <div class="finder__search" data-finder-search hidden>
          <label for="finder-words">Search by name or material (optional)</label>
          <input id="finder-words" name="words" type="search" autocomplete="off" placeholder="For example: flowers, music, yarn" />
        </div>
        <fieldset>
          <legend>Where will you be?</legend>
          <label class="choice">
            <input type="radio" name="setting" value="any" checked />
            <span>Anywhere</span>
          </label>
          {
            settings.map(([value, label]) => (
              <label class="choice">
                <input type="radio" name="setting" value={value} />
                <span>{label.charAt(0).toUpperCase() + label.slice(1)}</span>
              </label>
            ))
          }
        </fieldset>
        <fieldset>
          <legend>Who is taking part?</legend>
          <label class="choice">
            <input type="radio" name="group" value="any" checked />
            <span>Any</span>
          </label>
          {
            groups.map(([value, label]) => (
              <label class="choice">
                <input type="radio" name="group" value={value} />
                <span>{label}</span>
              </label>
            ))
          }
        </fieldset>
        <fieldset>
          <legend>How much mess is okay?</legend>
          {
            MESS_CHOICES.map((c) => (
              <label class="choice">
                <input type="radio" name="mess" value={c.value} checked={c.value === 'any'} />
                <span>{c.label}</span>
              </label>
            ))
          }
        </fieldset>
        <fieldset>
          <legend>How much energy is there today?</legend>
          {
            ENERGY_CHOICES.map((c) => (
              <label class="choice">
                <input type="radio" name="energy" value={c.value} checked={c.value === 'any'} />
                <span>{c.label}</span>
              </label>
            ))
          }
        </fieldset>
        <fieldset>
          <legend>What do they enjoy most?</legend>
          {
            SENSE_CHOICES.map((c) => (
              <label class="choice">
                <input type="radio" name="sense" value={c.value} checked={c.value === 'any'} />
                <span>{c.label}</span>
              </label>
            ))
          }
        </fieldset>
        <fieldset>
          <legend>How much talking?</legend>
          {
            TALKING_CHOICES.map((c) => (
              <label class="choice">
                <input type="radio" name="talking" value={c.value} checked={c.value === 'any'} />
                <span>{c.label}</span>
              </label>
            ))
          }
        </fieldset>
        <fieldset>
          <legend>How much help can you give?</legend>
          {
            SUPERVISION_CHOICES.map((c) => (
              <label class="choice">
                <input type="radio" name="supervision" value={c.value} checked={c.value === 'any'} />
                <span>{c.label}</span>
              </label>
            ))
          }
        </fieldset>
        <p class="muted">We never ask about a diagnosis. Fit the activity to the moment, not to a label.</p>
      </details>
    </form>

    <p class="finder__count" id="finder-count" role="status" aria-live="polite">
      Showing all {activities.length} activities.
    </p>

    <ul class="activity-grid finder__results" id="finder-results">
      {
        activities.map((a) => {
          const alt = easier(a.data.variations);
          return (
            <li
              data-type={a.data.type}
              data-cost={a.data.cost}
              data-min={a.data.activityMinutes[0]}
              data-settings={a.data.settings.join(' ')}
              data-groups={a.data.groups.join(' ')}
              data-search={[a.data.name, a.data.summary, ...a.data.materials].join(' ')}
              data-mess={a.data.mess}
              data-energy={a.data.energy}
              data-supervision={a.data.supervision}
              data-senses={a.data.senses.join(' ')}
              data-variations={a.data.variations.map((v) => v.kind).join(' ')}
            >
              <a class="activity-card" href={`/activity/${a.id}/`}>
                <span class="activity-card__type">{TYPE_LABELS[a.data.type]}</span>
                <span class="activity-card__name">{a.data.name}</span>
                <span class="activity-card__summary">{a.data.summary}</span>
                <span class="activity-card__glance">
                  {glance(a.data).map((fact) => <span class="activity-card__fact">{fact}</span>)}
                </span>
                <span class="activity-card__why" hidden />
                <span class="activity-card__easier">
                  <strong>{VARIATION_LABELS[alt.kind]}:</strong> {alt.text}
                </span>
              </a>
            </li>
          );
        })
      }
    </ul>
    <p class="finder__empty" id="finder-empty" hidden>
      Nothing fits all of those choices yet. Try “Any” for one of them, or <a href="/activities/ideas/">browse more
      activity ideas</a>.
    </p>

    {
      hubs.length > 0 && (
        <nav class="hub-next reveal" aria-labelledby="by-situation">
          <h2 id="by-situation">Browse by situation</h2>
          <ul class="activity-list">
            {hubs.map((h) => (
              <li>
                <a href={`/${h.id}/`}>{h.data.title}</a>
              </li>
            ))}
          </ul>
        </nav>
      )
    }
  </div>
</BaseLayout>

<script>
  import { fitReasons, matches, type ActivityFacts, type ActivitySense, type FinderChoice } from '../lib/activities';
  import { browserStorage, loadSaved } from '../lib/saved-activities';
  import { matchesGuideSearch } from '../lib/guide-search';

  const form = document.getElementById('finder') as HTMLFormElement | null;
  const items = [...document.querySelectorAll<HTMLLIElement>('#finder-results > li')];
  const count = document.getElementById('finder-count');
  const empty = document.getElementById('finder-empty');

  function facts(li: HTMLLIElement): ActivityFacts {
    const d = li.dataset;
    return {
      type: d.type as ActivityFacts['type'],
      cost: d.cost as ActivityFacts['cost'],
      activityMinutes: [Number(d.min), Number(d.min)],
      settings: (d.settings ?? '').split(' ') as ActivityFacts['settings'],
      groups: (d.groups ?? '').split(' ') as ActivityFacts['groups'],
      prepMinutes: 0,
      mess: d.mess as ActivityFacts['mess'],
      energy: d.energy as ActivityFacts['energy'],
      supervision: d.supervision as ActivityFacts['supervision'],
      senses: (d.senses ?? '').split(' ').filter(Boolean) as ActivitySense[],
      variationKinds: (d.variations ?? '').split(' ').filter(Boolean),
    };
  }

  function update(): void {
    if (!form) return;
    const data = new FormData(form);
    const choice: FinderChoice = Object.fromEntries(
      ['time', 'materials', 'type', 'setting', 'group', 'mess', 'energy', 'supervision', 'sense', 'talking'].map((k) => [k, String(data.get(k) ?? 'any')]),
    );
    const words = String(data.get('words') ?? '');
    let shown = 0;
    for (const li of items) {
      const fits = matches(facts(li), choice) && matchesGuideSearch(li.dataset.search ?? '', words);
      li.hidden = !fits;
      const why = li.querySelector<HTMLElement>('.activity-card__why');
      const reasons = fits ? fitReasons(facts(li), choice) : [];
      if (why) {
        why.hidden = reasons.length === 0;
        why.textContent = reasons.length > 0 ? `Why it fits: ${reasons.join(', ')}.` : '';
      }
      if (fits) shown += 1;
    }
    if (count) {
      count.textContent =
        shown === items.length ? `Showing all ${items.length} activities.` : `Showing ${shown} of ${items.length} activities.`;
    }
    if (empty) empty.hidden = shown > 0;
  }

  // Activities saved on their own pages, listed by the names already on this page.
  const savedSection = document.getElementById('saved-activities');
  const savedList = document.getElementById('saved-list');
  const names = new Map(
    items.map((li) => {
      const link = li.querySelector<HTMLAnchorElement>('a.activity-card');
      return [link?.pathname.split('/')[2] ?? '', link?.querySelector('.activity-card__name')?.textContent ?? ''];
    }),
  );
  const saved = loadSaved(browserStorage()).filter((slug) => names.get(slug));
  if (savedSection && savedList && saved.length > 0) {
    for (const slug of saved) {
      const li = document.createElement('li');
      const a = document.createElement('a');
      a.href = `/activity/${slug}/`;
      a.textContent = names.get(slug) ?? slug;
      li.append(a);
      savedList.append(li);
    }
    savedSection.hidden = false;
  }

  // The word search needs this script, so it appears only when the script runs.
  document.querySelector<HTMLElement>('[data-finder-search]')?.removeAttribute('hidden');
  form?.addEventListener('change', update);
  form?.addEventListener('input', update);
  form?.addEventListener('submit', (event) => event.preventDefault());
</script>
