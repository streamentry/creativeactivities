---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { PACKS } from '../data/packs';
import '../styles/activity-cards.css';
import '../styles/activities.css';
import '../styles/studio-finder.css';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import ActivityCard from '../components/ActivityCard.astro';
import { breadcrumbs, itemList } from '../lib/schema';
import { FINDER_SETTINGS } from '../lib/finder-state';
import { lowerEffortPick, lowerEffortReasons, type EffortFacts } from '../lib/lower-effort';
import {
  ENERGY_CHOICES,
  SUPERVISION_CHOICES,
  SENSE_CHOICES,
  TALKING_CHOICES,
  GROUP_LABELS,
  MATERIAL_CHOICES,
  MESS_CHOICES,
  SETTING_LABELS,
  TIME_CHOICES,
  TYPE_LABELS,
  VARIATION_LABELS,
  FILTER_LABELS,
  FILTERABLE_FLAGS,
  glance,
  listedActivities,
} from '../lib/activities';

const hubs = (await getCollection('hubs')).sort((a, b) => a.data.title.localeCompare(b.data.title));
const activities = listedActivities(await getCollection('activityCards')).sort((a, b) => a.data.name.localeCompare(b.data.name));
const crumbs = [{ href: '/activity/', label: 'Find an activity' }];
const title = 'Find an Activity to Do Together';
const description =
  'Free creative activities to start together today: crafts, painting, plants, music and stories, with setup time, materials, easier versions and a printable card.';
const types = Object.entries(TYPE_LABELS);
const settings = FINDER_SETTINGS.map((s) => [s, SETTING_LABELS[s]] as const);
const groups = Object.entries(GROUP_LABELS);
const easier = (kinds: { kind: string; text: string }[]) =>
  kinds.find((v) => v.kind === 'easier') ?? kinds.find((v) => v.kind === 'bedside') ?? kinds[0];
/** Effort of a card, for the lower-effort option (WEB-004). */
const effortOf = (a: (typeof activities)[number]): EffortFacts => ({
  slug: a.id,
  energy: a.data.energy,
  cost: a.data.cost,
  materials: a.data.materials.length,
  prepMinutes: a.data.prepMinutes,
});
/** The static fallback: the first card is the top result with no choices made, and the option is its lighter candidate. */
const lowerStatic = (() => {
  const [top, ...rest] = activities;
  if (!top) return undefined;
  const pick = lowerEffortPick(effortOf(top), rest.map(effortOf));
  const card = rest.find((a) => a.id === pick?.slug);
  if (!card || !pick) return undefined;
  return { card, reasons: lowerEffortReasons(pick, effortOf(top)) };
})();
---
<BaseLayout title={title} description={description} image="/og/activities.png" jsonLd={[breadcrumbs(crumbs), itemList(title, activities.map((a) => ({ path: `/activity/${a.id}/`, name: a.data.name })))]}>
  <Breadcrumbs items={crumbs} />
  <div class="container">
    <header class="page-head">
      <p class="eyebrow">Find an activity</p>
      <h1>What would you like to do together?</h1>
      <p class="lede">
        Every activity here can start with everyday things, needs no account and comes with an easier version and a
        card to print. Choose as much or as little as you like below. “Any” is always fine.
      </p>
      {
        PACKS.map((p) => (
          <p>
            Want a few ready to go? <a href={`/activity/packs/${p.id}/`}>Print {p.title.split(':')[0].toLowerCase()}</a>, one card per page.
          </p>
        ))
      }
      <p>
        Planning for a group? <a href="/activity/weekly-program/">Print a weekly activity program</a> with a group and a
        one-to-one version for each day.
      </p>
      <p>Not sure what a craft word means? <a href="/glossary/">See the glossary</a>.</p>
    </header>

    <section class="finder-saved" id="saved-activities" aria-labelledby="saved-title" hidden>
      <h2 id="saved-title">Saved activities</h2>
      <p class="muted">Kept on this device only. Clearing this site's data removes them.</p>
      <ul class="activity-list" id="saved-list"></ul>
    </section>

    <form class="finder" id="finder" aria-label="Find an activity">
      <fieldset>
        <legend>How much time do you have?</legend>
        {
          TIME_CHOICES.map((c) => (
            <label class="choice">
              <input type="radio" name="time" value={c.value} checked={c.value === 'any'} />
              <span>{c.label}</span>
            </label>
          ))
        }
      </fieldset>
      <fieldset>
        <legend>What do you have to hand?</legend>
        {
          MATERIAL_CHOICES.map((c) => (
            <label class="choice">
              <input type="radio" name="materials" value={c.value} checked={c.value === 'any'} />
              <span>{c.label}</span>
            </label>
          ))
        }
      </fieldset>
      <fieldset>
        <legend>What kind of activity?</legend>
        <label class="choice">
          <input type="radio" name="type" value="any" checked />
          <span>Any</span>
        </label>
        {
          types.map(([value, label]) => (
            <label class="choice">
              <input type="radio" name="type" value={value} />
              <span>{label}</span>
            </label>
          ))
        }
      </fieldset>
      <details class="finder__more">
        <summary>More ways to fit the moment (optional)</summary>
        <div class="finder__search" data-finder-search hidden>
          <label for="finder-words">Search by name or material (optional)</label>
          <input id="finder-words" name="words" type="search" autocomplete="off" placeholder="For example: flowers, music, yarn" />
        </div>
        <fieldset>
          <legend>Where will you be?</legend>
          <label class="choice">
            <input type="radio" name="setting" value="any" checked />
            <span>Anywhere</span>
          </label>
          {
            settings.map(([value, label]) => (
              <label class="choice">
                <input type="radio" name="setting" value={value} />
                <span>{label.charAt(0).toUpperCase() + label.slice(1)}</span>
              </label>
            ))
          }
        </fieldset>
        <fieldset>
          <legend>Who is taking part?</legend>
          <label class="choice">
            <input type="radio" name="group" value="any" checked />
            <span>Any</span>
          </label>
          {
            groups.map(([value, label]) => (
              <label class="choice">
                <input type="radio" name="group" value={value} />
                <span>{label}</span>
              </label>
            ))
          }
        </fieldset>
        <fieldset>
          <legend>How much mess is okay?</legend>
          {
            MESS_CHOICES.map((c) => (
              <label class="choice">
                <input type="radio" name="mess" value={c.value} checked={c.value === 'any'} />
                <span>{c.label}</span>
              </label>
            ))
          }
        </fieldset>
        <fieldset>
          <legend>How much energy is there today?</legend>
          {
            ENERGY_CHOICES.map((c) => (
              <label class="choice">
                <input type="radio" name="energy" value={c.value} checked={c.value === 'any'} />
                <span>{c.label}</span>
              </label>
            ))
          }
        </fieldset>
        <fieldset>
          <legend>What do they enjoy most?</legend>
          {
            SENSE_CHOICES.map((c) => (
              <label class="choice">
                <input type="radio" name="sense" value={c.value} checked={c.value === 'any'} />
                <span>{c.label}</span>
              </label>
            ))
          }
        </fieldset>
        <fieldset>
          <legend>How much talking?</legend>
          {
            TALKING_CHOICES.map((c) => (
              <label class="choice">
                <input type="radio" name="talking" value={c.value} checked={c.value === 'any'} />
                <span>{c.label}</span>
              </label>
            ))
          }
        </fieldset>
        <fieldset>
          <legend>How much help can you give?</legend>
          {
            SUPERVISION_CHOICES.map((c) => (
              <label class="choice">
                <input type="radio" name="supervision" value={c.value} checked={c.value === 'any'} />
                <span>{c.label}</span>
              </label>
            ))
          }
        </fieldset>
        <fieldset>
          <legend>Leave out activities that need</legend>
          {
            FILTERABLE_FLAGS.map((flag) => (
              <label class="choice">
                <input type="checkbox" name="avoid" value={flag} />
                <span>{FILTER_LABELS[flag] ?? flag}</span>
              </label>
            ))
          }
        </fieldset>
        <p class="muted">We never ask about a diagnosis. Fit the activity to the moment, not to a label.</p>
      </details>
    </form>

    <p class="finder__count" id="finder-count" role="status" aria-live="polite">
      Showing all {activities.length} activities.
    </p>

    <section class="finder__one-idea" id="one-idea" aria-labelledby="one-idea-title" hidden>
      <h2 id="one-idea-title">One idea right now</h2>
      <p class="muted">Short on time? See one activity that fits your choices, then another if it does not suit. It stops after a few.</p>
      <ul class="activity-grid" id="one-idea-list" aria-live="polite"></ul>
      <p class="muted" id="one-idea-end" hidden></p>
      <button type="button" class="btn" id="one-idea-next">Show me one idea</button>
    </section>

    <section class="finder__lower" id="finder-lower" aria-labelledby="finder-lower-title" hidden={!lowerStatic}>
      <h2 id="finder-lower-title">A lower-effort option</h2>
      <p class="muted" id="finder-lower-why">{lowerStatic ? `Why it is lighter: ${lowerStatic.reasons.join(', ')}.` : ''}</p>
      <ul class="activity-grid" id="finder-lower-list">
        {
          lowerStatic && (
            <li>
              <ActivityCard activity={lowerStatic.card} variation={easier(lowerStatic.card.data.variations).kind} />
            </li>
          )
        }
      </ul>
    </section>

    <ul class="activity-grid finder__results" id="finder-results">
      {
        activities.map((a) => {
          const alt = easier(a.data.variations);
          return (
            <li
              data-type={a.data.type}
              data-cost={a.data.cost}
              data-min={a.data.activityMinutes[0]}
              data-settings={a.data.settings.join(' ')}
              data-groups={a.data.groups.join(' ')}
              data-search={[a.data.name, a.data.summary, ...a.data.materials].join(' ')}
              data-mess={a.data.mess}
              data-energy={a.data.energy}
              data-supervision={a.data.supervision}
              data-senses={a.data.senses.join(' ')}
              data-variations={a.data.variations.map((v) => v.kind).join(' ')}
              data-flags={a.data.safetyFlags.join(' ')}
              data-slug={a.id}
              data-materials={a.data.materials.length}
              data-prep={a.data.prepMinutes}
            >
              <a class="activity-card" href={`/activity/${a.id}/`}>
                <span class="activity-card__type">{TYPE_LABELS[a.data.type]}</span>
                <span class="activity-card__name">{a.data.name}</span>
                <span class="activity-card__summary">{a.data.summary}</span>
                <span class="activity-card__glance">
                  {glance(a.data).map((fact) => <span class="activity-card__fact">{fact}</span>)}
                </span>
                <span class="activity-card__why" hidden />
                <span class="activity-card__easier">
                  <strong>{VARIATION_LABELS[alt.kind]}:</strong> {alt.text}
                </span>
              </a>
            </li>
          );
        })
      }
    </ul>
    <p class="finder__empty" id="finder-empty" hidden>
      Nothing fits all of those choices yet. Try “Any” for one of them, or <a href="/activities/ideas/">browse more
      activity ideas</a>.
    </p>

    {
      hubs.length > 0 && (
        <nav class="hub-next reveal" aria-labelledby="by-situation">
          <h2 id="by-situation">Browse by situation</h2>
          <ul class="activity-list">
            {hubs.map((h) => (
              <li>
                <a href={`/${h.id}/`}>{h.data.title}</a>
              </li>
            ))}
          </ul>
        </nav>
      )
    }
  </div>
</BaseLayout>

<script>
  import {
    fitReasons,
    matches,
    type ActivityFacts,
    type ActivitySense,
    type FinderChoice,
    type SafetyFlag,
  } from '../lib/activities';
  import { browserStorage, loadSaved } from '../lib/saved-activities';
  import { matchesGuideSearch } from '../lib/guide-search';
  import { countFitFilters, parseFinderState, serializeFinderState, shouldNoindex } from '../lib/finder-state';
  import { lowerEffortPick, lowerEffortReasons, type EffortFacts } from '../lib/lower-effort';
  import { ideaAt, ideaEndText } from '../lib/one-idea';

  const form = document.getElementById('finder') as HTMLFormElement | null;
  const words = document.getElementById('finder-words') as HTMLInputElement | null;
  const items = [...document.querySelectorAll<HTMLLIElement>('#finder-results > li')];
  const count = document.getElementById('finder-count');
  const empty = document.getElementById('finder-empty');
  const lower = document.getElementById('finder-lower');
  const lowerList = document.getElementById('finder-lower-list');
  const lowerWhy = document.getElementById('finder-lower-why');
  const robots = document.querySelector<HTMLMetaElement>('meta[name="robots"]');
  const indexedRobots = robots?.content ?? 'index, follow';

  /** The choices the URL carries (WEB-005). The search box is not one of them. */
  const KEYS = ['time', 'materials', 'type', 'setting', 'group', 'mess', 'energy', 'sense', 'talking', 'supervision'] as const;

  function facts(li: HTMLLIElement): ActivityFacts {
    const d = li.dataset;
    return {
      type: d.type as ActivityFacts['type'],
      cost: d.cost as ActivityFacts['cost'],
      activityMinutes: [Number(d.min), Number(d.min)],
      settings: (d.settings ?? '').split(' ') as ActivityFacts['settings'],
      groups: (d.groups ?? '').split(' ') as ActivityFacts['groups'],
      prepMinutes: 0,
      mess: d.mess as ActivityFacts['mess'],
      energy: d.energy as ActivityFacts['energy'],
      supervision: d.supervision as ActivityFacts['supervision'],
      senses: (d.senses ?? '').split(' ').filter(Boolean) as ActivitySense[],
      variationKinds: (d.variations ?? '').split(' ').filter(Boolean),
      safetyFlags: (d.flags ?? '').split(' ').filter(Boolean) as SafetyFlag[],
    };
  }

  function effort(li: HTMLLIElement): EffortFacts {
    const d = li.dataset;
    return {
      slug: d.slug ?? '',
      energy: d.energy as EffortFacts['energy'],
      cost: d.cost as EffortFacts['cost'],
      materials: Number(d.materials),
      prepMinutes: Number(d.prep),
    };
  }

  /** The choices as the form shows them now. */
  function readForm(): FinderChoice {
    if (!form) return {};
    const data = new FormData(form);
    return {
      ...Object.fromEntries(KEYS.map((k) => [k, String(data.get(k) ?? 'any')])),
      avoid: data.getAll('avoid').map(String),
    };
  }

  /** Shows the choices in the form, as the URL says them. */
  function writeForm(choice: FinderChoice): void {
    if (!form) return;
    for (const key of KEYS) {
      const value = choice[key] ?? 'any';
      for (const input of form.querySelectorAll<HTMLInputElement>(`input[name="${key}"]`)) {
        input.checked = input.value === value;
      }
    }
    for (const box of form.querySelectorAll<HTMLInputElement>('input[name="avoid"]')) {
      box.checked = (choice.avoid ?? []).includes(box.value);
    }
  }

  /** Shows the lower-effort card for the first shown result (WEB-004). */
  function renderLower(visible: HTMLLIElement[]): void {
    if (!lower || !lowerList || !lowerWhy) return;
    const [top, ...rest] = visible;
    const pick = top ? lowerEffortPick(effort(top), rest.map(effort)) : undefined;
    const pickItem = rest.find((li) => li.dataset.slug === pick?.slug);
    lower.hidden = !(top && pickItem);
    lowerList.replaceChildren();
    if (!top || !pickItem) return;
    const item = document.createElement('li');
    const anchor = pickItem.querySelector<HTMLAnchorElement>('a.activity-card');
    if (anchor) item.append(anchor.cloneNode(true));
    lowerList.append(item);
    lowerWhy.textContent = `Why it is lighter: ${lowerEffortReasons(effort(pickItem), effort(top)).join(', ')}.`;
  }

  /** Three or more fit filters: noindex, so near-duplicate states stay out of search (WEB-005). */
  function setRobots(noindex: boolean): void {
    if (robots) robots.content = noindex ? 'noindex, follow' : indexedRobots;
  }

  // One idea right now (WEB-007): one card at a time from the cards that fit, ending after a short run.
  const ideaBox = document.getElementById('one-idea');
  const ideaList = document.getElementById('one-idea-list');
  const ideaEnd = document.getElementById('one-idea-end');
  const ideaNext = document.getElementById('one-idea-next') as HTMLButtonElement | null;
  let ideaIndex = 0;
  const fittingSlugs = () => items.filter((li) => !li.hidden).map((li) => li.dataset.slug ?? '');
  function resetIdeas(): void {
    ideaIndex = 0;
    ideaList?.replaceChildren();
    if (ideaEnd) ideaEnd.hidden = true;
    if (ideaNext) {
      ideaNext.hidden = false;
      ideaNext.textContent = 'Show me one idea';
    }
  }
  function showNextIdea(): void {
    if (!ideaList || !ideaNext || !ideaEnd) return;
    const step = ideaAt(fittingSlugs(), ideaIndex);
    ideaList.replaceChildren();
    if (step.slug) {
      const source = items.find((li) => li.dataset.slug === step.slug);
      const anchor = source?.querySelector<HTMLAnchorElement>('a.activity-card');
      if (anchor) {
        const item = document.createElement('li');
        item.append(anchor.cloneNode(true));
        ideaList.append(item);
      }
      ideaIndex += 1;
    }
    if (step.slug && step.more) {
      ideaNext.textContent = 'Another idea';
      ideaEnd.hidden = true;
    } else {
      ideaNext.hidden = true;
      ideaEnd.hidden = false;
      ideaEnd.textContent = ideaEndText(step.slug ? step.position : step.position - 1);
    }
  }
  if (ideaBox && ideaNext) {
    ideaBox.hidden = false;
    ideaNext.addEventListener('click', showNextIdea);
  }

  function render(choice: FinderChoice): void {
    const wordsValue = words?.value ?? '';
    const visible: HTMLLIElement[] = [];
    for (const li of items) {
      const fits = matches(facts(li), choice) && matchesGuideSearch(li.dataset.search ?? '', wordsValue);
      li.hidden = !fits;
      const why = li.querySelector<HTMLElement>('.activity-card__why');
      const reasons = fits ? fitReasons(facts(li), choice) : [];
      if (why) {
        why.hidden = reasons.length === 0;
        why.textContent = reasons.length > 0 ? `Why it fits: ${reasons.join(', ')}.` : '';
      }
      if (fits) visible.push(li);
    }
    const shown = visible.length;
    if (count) {
      count.textContent =
        shown === items.length ? `Showing all ${items.length} activities.` : `Showing ${shown} of ${items.length} activities.`;
    }
    if (empty) empty.hidden = shown > 0;
    renderLower(visible);
    resetIdeas();
    setRobots(shouldNoindex(choice));
  }

  /**
   * Keeps the address in step with the choices. A change of choice is a history
   * entry, so Back returns to the previous choices; a restore replaces the entry.
   */
  function syncAddress(choice: FinderChoice, push: boolean): void {
    const query = serializeFinderState(choice);
    const next = query ? `${location.pathname}?${query}` : location.pathname;
    if (next === `${location.pathname}${location.search}`) return;
    if (push) history.pushState(null, '', next);
    else history.replaceState(null, '', next);
  }

  function openIfChosen(choice: FinderChoice): void {
    if (countFitFilters(choice) > 0) document.querySelector<HTMLDetailsElement>('.finder__more')?.setAttribute('open', '');
  }

  // Restore the choices from the address, then show them.
  const initial = parseFinderState(location.search);
  writeForm(initial);
  openIfChosen(initial);
  render(readForm());
  syncAddress(readForm(), false);

  form?.addEventListener('change', (event) => {
    const choice = readForm();
    render(choice);
    // The search box is not in the address, so typing or leaving it never adds history.
    if (event.target !== words) syncAddress(choice, true);
  });
  form?.addEventListener('input', (event) => {
    if (event.target === words) render(readForm());
  });
  window.addEventListener('popstate', () => {
    const choice = parseFinderState(location.search);
    writeForm(choice);
    openIfChosen(choice);
    render(readForm());
  });

  // Activities saved on their own pages, listed by the names already on this page.
  const savedSection = document.getElementById('saved-activities');
  const savedList = document.getElementById('saved-list');
  const names = new Map(
    items.map((li) => {
      const link = li.querySelector<HTMLAnchorElement>('a.activity-card');
      return [link?.pathname.split('/')[2] ?? '', link?.querySelector('.activity-card__name')?.textContent ?? ''];
    }),
  );
  const saved = loadSaved(browserStorage()).filter((slug) => names.get(slug));
  if (savedSection && savedList && saved.length > 0) {
    for (const slug of saved) {
      const li = document.createElement('li');
      const a = document.createElement('a');
      a.href = `/activity/${slug}/`;
      a.textContent = names.get(slug) ?? slug;
      li.append(a);
      savedList.append(li);
    }
    savedSection.hidden = false;
  }

  // The word search needs this script, so it appears only when the script runs.
  document.querySelector<HTMLElement>('[data-finder-search]')?.removeAttribute('hidden');
  form?.addEventListener('submit', (event) => event.preventDefault());
</script>
