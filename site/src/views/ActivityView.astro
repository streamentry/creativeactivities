---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/activity-cards.css';
import '../styles/activities.css';
import '../styles/studio-activity.css';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Icon from '../components/Icon.astro';
import SafetyFlags from '../components/SafetyFlags.astro';
import CrisisRoute from '../components/CrisisRoute.astro';
import ActivityImage from '../components/ActivityImage.astro';
import ActivityFeedback from '../components/ActivityFeedback.astro';
import SuggestCorrection from '../components/SuggestCorrection.astro';
import { SITE } from '../lib/site';
import { breadcrumbs, howTo } from '../lib/schema';
import {
  SAFETY_FLAG_LABELS,
  TYPE_LABELS,
  VARIATION_LABELS,
  factList,
  glance,
  listedActivities,
  reviewByline,
  REVIEW_LIMIT,
} from '../lib/activities';
import { resolveGuide } from '../i18n/guides';
import { qrSvg } from '../lib/qr';
import ActivityChanges from '../components/ActivityChanges.astro';
import { PAUSE_LINE, SCOPE_LINE } from '../lib/scope';
import { STAGE_TEXT } from '../lib/group-stage';
import { relatedCards, type RelatedFacts } from '../lib/related';
import { overdueSince } from '../../scripts/review-queue-lib.mjs';

interface Props {
  activity: CollectionEntry<'activityCards'>;
}
const { activity } = Astro.props;
const d = activity.data;
const withdrawn = d.withdrawn;
const { Content } = await render(activity);
const path = `/activity/${activity.id}/`;
const crumbs = [
  { href: '/activity/', label: 'Find an activity' },
  { href: path, label: d.name },
];
/** The labelled ticket under the title: the facts a caregiver needs before starting. */
const LEDGER = ['Setup', 'Activity', 'Cost', 'Mess', 'Where', 'Help'];
const ledger = factList(d).filter((f) => LEDGER.includes(f.label));
const qr = qrSvg(`${SITE.url}${path}`, `QR code for the ${d.name} page`);
const dateText = (date: Date) =>
  date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
const isoDate = (date: Date) => date.toISOString().slice(0, 10);
/** WEB-076, TSA-036: past its review date at build time, the card says so; the date is never refreshed without a review. */
const reviewDue = overdueSince(isoDate(d.review?.date ?? d.updated), isoDate(new Date()));

const all = await getCollection('activityCards');
const shown = listedActivities(all);
/** Related cards: hand-picked first, then the best functional matches to three (WEB-008). */
const facts = (a: (typeof shown)[number]): RelatedFacts => ({
  slug: a.id,
  type: a.data.type,
  energy: a.data.energy,
  settings: a.data.settings,
  groups: a.data.groups,
  senses: a.data.senses,
  materials: a.data.materials,
});
const relatedSlugs = withdrawn ? [] : relatedCards(facts(activity), shown.map(facts), d.related, { min: 3, max: 4 });
const related = relatedSlugs
  .map((slug) => shown.find((a) => a.id === slug))
  .filter((a) => a !== undefined);
const guides = withdrawn
  ? []
  : (
      await Promise.all(
        d.guides.map(async (ref) => {
          const guide = await resolveGuide('en', ref);
          return guide ? { href: `/${guide.id}/`, title: guide.entry.data.title } : null;
        }),
      )
    )
      .filter((g) => g !== null)
      .filter((g, i, all) => all.findIndex((x) => x.href === g.href) === i);
/** Pictures of the finished result, and pictures attached to one step each (WEB-012). */
const resultImages = d.images.filter((image) => image.step === undefined && image.kind !== 'materials');
const materialsImages = d.images.filter((image) => image.kind === 'materials');
const stepImages = (step: number) => d.images.filter((image) => image.step === step);
const hasSmallParts = d.safetyFlags.includes('small-parts');

const jsonLd = withdrawn
  ? [breadcrumbs(crumbs)]
  : [
      howTo({
        path,
        name: d.name,
        description: d.description,
        updated: d.updated,
        published: d.published,
        totalMinutes: d.prepMinutes + d.activityMinutes[1],
        supplies: d.materials,
        steps: d.steps,
      }),
      breadcrumbs(crumbs),
    ];
---
<BaseLayout title={d.seoTitle ?? d.name} description={d.description} type="article" image="/og/activities.png" jsonLd={jsonLd} noindex={Boolean(withdrawn)}>
  <Breadcrumbs items={crumbs} />
  <div class="container activity activity-page" data-view={withdrawn ? undefined : activity.id}>
    {
      withdrawn ? (
        <header class="activity-head">
          <p class="eyebrow">Withdrawn</p>
          <h1>{d.name}</h1>
          <section class="activity-withdrawn" aria-labelledby="withdrawn-title">
            <h2 id="withdrawn-title">This activity has been withdrawn</h2>
            <p>{withdrawn.reason}</p>
            <p>
              Withdrawn on <time datetime={isoDate(withdrawn.date)}>{dateText(withdrawn.date)}</time>. Please do not print
              or use this card.
            </p>
            {withdrawn.replacement && <p>{withdrawn.replacement}</p>}
            <p>
              <a href="/activity/">Find another activity</a>
            </p>
          </section>
        </header>
      ) : (
        <>
    <header class="activity-head">
      <p class="eyebrow">{TYPE_LABELS[d.type]}</p>
      <h1 data-stage="title">{d.name}</h1>
      <p class="activity-head__summary" data-stage="summary">{d.summary}</p>
      <p class="activity-scope">{SCOPE_LINE}</p>
      <dl class="activity-ledger">
        {
          ledger.map((f) => (
            <div>
              <dt>{f.label}</dt>
              <dd>{f.value}</dd>
            </div>
          ))
        }
      </dl>
      {hasSmallParts && <p class="activity-age"><strong>{SAFETY_FLAG_LABELS['small-parts']}.</strong></p>}
      <p class="activity-materials"><strong>Materials:</strong> {d.materials.length} everyday things, listed below</p>
      <div class="btn-row no-print">
        <a class="btn btn--primary" href="#steps"><Icon name="play" />Start activity</a>
        <button type="button" class="btn" data-group-stage hidden><Icon name="people" />{STAGE_TEXT.open}</button>
        <button type="button" class="btn" data-print hidden><Icon name="print" />Print the card</button>
        <button type="button" class="btn" data-save={activity.id} aria-pressed="false" hidden>
          <Icon name="heart" /><span data-save-label>Save for later</span>
        </button>
        <button type="button" class="btn" data-share={activity.id} data-share-text={activity.data.summary} hidden><Icon name="share" />Share</button>
      </div>
      <p class="no-print activity-large-print"><a href={`${path}large-print/`}>Large-print card</a> (same steps, bigger type)</p>
      <p class="activity-status no-print" data-activity-status role="status" aria-live="polite"></p>
      {d.enjoy && <p class="activity-head__enjoy"><strong>Who might enjoy it:</strong> {d.enjoy}</p>}
    </header>

    <div class="activity-layout">
      <div class="activity-main">
        <section class="activity-need" aria-labelledby="need">
          <h2 id="need">What you need</h2>
          {materialsImages.map((image) => <ActivityImage image={image} variant="materials" />)}
          <ul class="activity-list activity-check" data-stage="materials">
            {d.materials.map((m) => <li>{m}</li>)}
          </ul>
          {
            d.substitutions.length > 0 && (
              <>
                <h3>No need to buy anything special</h3>
                <ul class="activity-list">
                  {d.substitutions.map((s) => <li>{s}</li>)}
                </ul>
              </>
            )
          }
        </section>

        <section class="reveal" aria-labelledby="steps">
          <h2 id="steps" tabindex="-1">What to do</h2>
          {resultImages.map((image) => <ActivityImage image={image} />)}
          <ol class="activity-steps" data-stage="steps">
            {
              d.steps.map((step, i) => (
                <li>
                  {step}
                  {stepImages(i + 1).map((image) => <ActivityImage image={image} />)}
                </li>
              ))
            }
          </ol>
        </section>

        <section class="activity-stop reveal" aria-labelledby="stop">
          <h2 id="stop">It is okay to stop or change it</h2>
          <p data-stage="stop">{d.stopNote}</p>
          <p>{PAUSE_LINE}</p>
        </section>

        <ActivityFeedback activity={activity.id} />

        <section class="activity-adapt reveal" aria-labelledby="adapt">
          <h2 id="adapt">Make it easier or different</h2>
          {
            d.variations.length > 1 && (
              <nav class="variation-chips no-print" aria-labelledby="variation-chips-label">
                <p id="variation-chips-label" class="variation-chips__label">Jump to a version</p>
                <ul class="variation-chips__list">
                  {d.variations.map((v) => (
                    <li>
                      <a href={`#${v.kind}`} data-variation={v.kind}>{VARIATION_LABELS[v.kind]}</a>
                    </li>
                  ))}
                </ul>
              </nav>
            )
          }
          <dl class="activity-variations">
            {
              d.variations.map((v) => (
                <div id={v.kind} class="activity-variation" tabindex="-1">
                  <dt>{VARIATION_LABELS[v.kind]}</dt>
                  <dd>{v.text}</dd>
                </div>
              ))
            }
          </dl>
        </section>

        {d.crisisRoute && <CrisisRoute />}

        <section class="activity-safety reveal" aria-labelledby="safety">
          <h2 id="safety"><Icon name="shield" />Safety</h2>
          <SafetyFlags flags={d.safetyFlags} />
          <ul class="activity-list">
            {d.safety.map((s) => <li>{s}</li>)}
          </ul>
          <p class="muted">These are practical suggestions, not medical advice. You know the person best.</p>
        </section>

        {
          d.review && (
            <section class="activity-review reveal" aria-labelledby="review">
              <h2 id="review">What the reviewer checked</h2>
              <p>{d.review.scope}</p>
              <p class="muted">{REVIEW_LIMIT}</p>
              <h3>Not for</h3>
              <ul class="activity-list">
                {d.review.notFor.map((s) => <li>{s}</li>)}
              </ul>
              <h3>Not for use without someone nearby</h3>
              <ul class="activity-list">
                {d.review.notUnsupervised.map((s) => <li>{s}</li>)}
              </ul>
              <h3>Stop if</h3>
              <ul class="activity-list">
                {d.review.stopSigns.map((s) => <li>{s}</li>)}
              </ul>
            </section>
          )
        }

        <section class="prose activity-about reveal" aria-label="About this activity">
          <Content />
        </section>
      </div>

      <aside class="activity-aside" aria-label="At a glance">
        <div class="aside-box">
          <h2>At a glance</h2>
          <dl class="activity-facts">
            {
              factList(d).map((f) => (
                <div>
                  <dt>{f.label}</dt>
                  <dd>{f.value}</dd>
                </div>
              ))
            }
          </dl>
        </div>
      </aside>
    </div>

    {
      related.length > 0 && (
        <section class="section activity-next no-print reveal" aria-labelledby="next">
          <h2 id="next">What to try next</h2>
          <ul class="activity-grid">
            {related.map((a) => (
              <li>
                <a class="activity-card" href={`/activity/${a.id}/`}>
                  <span class="activity-card__type">{TYPE_LABELS[a.data.type]}</span>
                  <span class="activity-card__name">{a.data.name}</span>
                  <span class="activity-card__glance">{glance(a.data).slice(0, 3).join(' · ')}</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }
        </>
      )
    }

    {!withdrawn && <ActivityChanges changes={d.changes} updated={d.updated} />}

    <footer class="activity-byline">
      <p>
        {/* Explicit spaces: Astro drops the line breaks between text, expressions and tags. */}
        By {d.author}.{' '}
        {reviewByline(d.review, dateText(d.review?.date ?? d.updated))}{' '}
        Published <time datetime={isoDate(d.published)}>{dateText(d.published)}</time>, updated{' '}
        <time datetime={isoDate(d.updated)}>{dateText(d.updated)}</time>.{' '}
        {reviewDue && (
          <>
            <strong data-review-due>Due for a check since <time datetime={reviewDue}>{dateText(new Date(`${reviewDue}T00:00:00Z`))}</time>.</strong>{' '}
            Read the safety notes with extra care until it is checked.{' '}
          </>
        )}
        <a href="/editorial-policy/">How we write</a> ·{' '}
        <a href="/corrections/#report-safety">Report a safety problem</a>
      </p>
      <SuggestCorrection title={d.name} path={path} />
      {
        guides.length > 0 && (
          <p class="no-print">
            Recommended in:{' '}
            {guides.map((g, i) => (
              <>
                {i > 0 && ', '}
                <a href={g.href}>{g.title}</a>
              </>
            ))}
          </p>
        )
      }
      {
        !withdrawn && (
          <>
            <div class="print-only print-qr">
              <Fragment set:html={qr} />
              <p>
                Scan for easier versions, safety notes and more ideas, or visit {SITE.domain}{path}.
                Free to print and share for personal and noncommercial use.
              </p>
            </div>
            <p class="print-only print-version">
              Version {isoDate(d.updated)} · {SITE.domain}{path}
            </p>
          </>
        )
      }
    </footer>
  </div>
  <link rel="stylesheet" href="/styles/activity-print.css" media="print" />
</BaseLayout>

<script>
  import { browserStorage, isSaved, loadSaved, saveSaved, toggleSaved } from '../lib/saved-activities';
  import { track } from '../lib/track';

  // One view per page load, with the activity key only (TSA-012).
  const viewed = document.querySelector<HTMLElement>('[data-view]')?.dataset.view;
  if (viewed) track('activity_view', { activity: viewed });

  const status = document.querySelector<HTMLElement>('[data-activity-status]');
  const say = (text: string) => {
    if (status) status.textContent = text;
  };

  // Save for later: only this activity's address, in this browser; nothing is sent anywhere.
  const saveButton = document.querySelector<HTMLButtonElement>('[data-save]');
  const storage = browserStorage();
  if (saveButton && storage) {
    const slug = saveButton.dataset.save ?? '';
    const label = saveButton.querySelector<HTMLElement>('[data-save-label]');
    const show = (saved: boolean) => {
      saveButton.setAttribute('aria-pressed', String(saved));
      if (label) label.textContent = saved ? 'Saved' : 'Save for later';
    };
    show(isSaved(loadSaved(storage), slug));
    saveButton.hidden = false;
    saveButton.addEventListener('click', () => {
      const next = toggleSaved(loadSaved(storage), slug);
      if (!saveSaved(storage, next)) {
        say('This browser did not allow saving. The page address still works as a bookmark.');
        return;
      }
      const saved = isSaved(next, slug);
      show(saved);
      if (saved) track('activity_save', { activity: slug });
      say(saved ? 'Saved on this device. Find it under Saved activities on the Find an activity page.' : 'Removed from saved activities.');
    });
  }

  // Share: the device's share sheet where there is one, otherwise copy the link.
  const shareButton = document.querySelector<HTMLButtonElement>('[data-share]');
  const url = `${location.origin}${location.pathname}`;
  if (shareButton && (typeof navigator.share === 'function' || navigator.clipboard)) {
    shareButton.hidden = false;
    shareButton.addEventListener('click', async () => {
      track('activity_share', { activity: shareButton.dataset.share ?? '' });
      if (typeof navigator.share === 'function') {
        try {
          await navigator.share({ title: document.title, text: shareButton.dataset.shareText, url });
        } catch {
          // Closing the share sheet is a choice, not an error.
        }
        return;
      }
      try {
        await navigator.clipboard.writeText(url);
        say('Link copied. Paste it into a message or an email.');
      } catch {
        say(`Copy this link to share it: ${url}`);
      }
    });
  }

  // Print is a button only with JavaScript; without it, the browser's own print command shows the same print styles.
  for (const button of document.querySelectorAll<HTMLButtonElement>('[data-print]')) {
    button.hidden = false;
    button.addEventListener('click', () => window.print());
  }

  // Variation chips: a real link to each version (works without JavaScript). With it, the chosen version
  // is marked and focused in place, without a reload, and every version stays on the page.
  const chips = [...document.querySelectorAll<HTMLAnchorElement>('[data-variation]')];
  const choose = (kind: string) => {
    for (const chip of chips) {
      if (chip.dataset.variation === kind) chip.setAttribute('aria-current', 'true');
      else chip.removeAttribute('aria-current');
    }
    for (const item of document.querySelectorAll<HTMLElement>('.activity-variation')) {
      item.classList.toggle('is-chosen', item.id === kind);
    }
  };
  for (const chip of chips) {
    chip.addEventListener('click', (event) => {
      const kind = chip.dataset.variation ?? '';
      const target = document.getElementById(kind);
      if (!target) return;
      event.preventDefault();
      choose(kind);
      history.replaceState(null, '', `#${kind}`);
      target.focus();
    });
  }
  const chooseFromHash = () => {
    const kind = location.hash.slice(1);
    if (chips.some((chip) => chip.dataset.variation === kind)) choose(kind);
  };
  chooseFromHash();
  window.addEventListener('hashchange', chooseFromHash);
  // Group mode (WEB-046): the card one step at a time on a shared screen. Its code and styles load only when it is opened.
  const stageButton = document.querySelector<HTMLButtonElement>('[data-group-stage]');
  if (stageButton && typeof HTMLDialogElement !== 'undefined' && typeof HTMLDialogElement.prototype.showModal === 'function') {
    stageButton.hidden = false;
    stageButton.addEventListener('click', async () => {
      try {
        const { openGroupStage } = await import('../lib/group-stage-dom');
        await openGroupStage(stageButton);
      } catch {
        say('The group view did not open. The steps are still on this page.');
      }
    });
  }
  // "Start activity" moves focus to the steps, not only the scroll position.
  document.querySelector('a[href="#steps"]')?.addEventListener('click', () => {
    requestAnimationFrame(() => document.getElementById('steps')?.focus());
  });
</script>
