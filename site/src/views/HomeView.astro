---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/activities.css';
import '../styles/studio-home.css';
import { TYPE_LABELS, glance } from '../lib/activities';
import GameCard from '../components/GameCard.astro';
import GuideCard from '../components/GuideCard.astro';
import Faq from '../components/Faq.astro';
import Icon from '../components/Icon.astro';
import type { IconName } from '../lib/icons';
import PlayCta from '../components/PlayCta.astro';
import { pictureUrl } from '../data/pictures';
import { SITE } from '../lib/site';
import { playStoreUrl } from '../lib/store-links';
import { faqPage, organization, website } from '../lib/schema';
import { isIndexable, localePath, localizeHtml } from '../i18n/locales';
import { localizedGames } from '../i18n/games';
import { PUBLISHED, fill, ui } from '../i18n/ui';

interface Props {
  lang: string;
}
const { lang } = Astro.props;
const t = ui(lang);
const h = t.home;
const l = (path: string) => localePath(lang, path);
const games = localizedGames(lang);
const featured = games.filter((g) => g.featured).slice(0, 6);
const jsonLd = [website(PUBLISHED.filter((p) => isIndexable(p.code)).map((p) => p.bcp47)), organization(), faqPage(h.faq)];
const collage = ['teacup', 'sunflower', 'dog', 'sailboat'];
// Activity cards are English-first; translated home pages keep their games-first hero.
const FEATURED_ACTIVITIES = [
  'make-a-memory-collage',
  'arrange-flowers-together',
  'paint-with-watercolors',
  'make-a-personal-songbook',
  'wind-a-ball-of-yarn',
  'make-a-family-tree-of-hands',
];
const activityCards = lang === 'en'
  ? (await getCollection('activityCards'))
      .filter((a) => FEATURED_ACTIVITIES.includes(a.id))
      .sort((a, b) => FEATURED_ACTIVITIES.indexOf(a.id) - FEATURED_ACTIVITIES.indexOf(b.id))
  : [];
const hubs =
  lang === 'en' ? (await getCollection('hubs')).sort((a, b) => a.data.title.localeCompare(b.data.title)) : [];
---
<BaseLayout title={h.title} rawTitle description={h.description} jsonLd={jsonLd} available={PUBLISHED.map((p) => p.code)}>
  <section class="home-hero" aria-labelledby="hero-title">
    <div class="container home-hero__grid">
      <div class="home-hero__copy">
        <p class="eyebrow">{h.eyebrow}</p>
        <h1 id="hero-title">{h.h1}</h1>
        <p class="lede">{h.lede}</p>
        <div class="home-paths">
          {
            lang === 'en' ? (
              <>
                <a class="btn btn--primary btn--hero home-path" href="/activity/"><span>Help me choose</span><Icon name="arrow" /></a>
                <a class="btn btn--hero home-path" href="/activities/"><span>I know what I need</span><Icon name="arrow" /></a>
              </>
            ) : (
              <>
                <a class="btn btn--primary btn--hero home-path" href={l('/games/picture-pairs/')}><Icon name="play" /><span>{h.playGame}</span><Icon name="arrow" /></a>
                <a class="btn btn--hero home-path" href={l('/activities/ideas/')}><span>{h.findIdeas}</span><Icon name="arrow" /></a>
              </>
            )
          }
        </div>
        <ul class="home-facts">
          {h.facts.map((fact) => <li><Icon name="check" />{fact}</li>)}
        </ul>
        <p class="home-hero__app"><Icon name="phone" /><a href={l('/app/')}>{h.heroApp}</a></p>
      </div>
      <div class="home-album" aria-hidden="true">
        {
          collage.map((id, i) => (
            <figure class={`home-print home-print--${i + 1}`}>
              <img src={pictureUrl(id)} alt="" width="220" height="220" fetchpriority={i === 0 ? 'high' : 'auto'} />
            </figure>
          ))
        }
        <p class="home-album__note">{h.albumNote}</p>
      </div>
    </div>
  </section>

  {
    activityCards.length > 0 && (
      <section class="section home-activities" aria-labelledby="start-title">
        <div class="container">
          <div class="section-head">
            <div>
              <p class="eyebrow">Away from the screen</p>
              <h2 id="start-title">Start with an activity card</h2>
              <p class="lede">Everyday materials, one action per step, an easier version and a page to print.</p>
            </div>
            <a class="btn" href="/activity/">See all activities <Icon name="arrow" /></a>
          </div>
          <ul class="activity-grid home-bento reveal">
            {activityCards.map((a) => (
              <li>
                <a class="activity-card" href={`/activity/${a.id}/`}>
                  <span class="activity-card__type">{TYPE_LABELS[a.data.type]}</span>
                  <span class="activity-card__name">{a.data.name}</span>
                  <span class="activity-card__summary">{a.data.summary}</span>
                  <span class="activity-card__glance">{glance(a.data).slice(0, 3).join(' · ')}</span>
                </a>
              </li>
            ))}
          </ul>
          {hubs.length > 0 && (
            <nav class="home-hubs reveal" aria-labelledby="hubs-title">
              <h3 id="hubs-title">Or choose by situation</h3>
              <ul>
                {hubs.map((hub) => (
                  <li>
                    <a href={`/${hub.id}/`}>{hub.data.eyebrow}<Icon name="arrow" /></a>
                  </li>
                ))}
              </ul>
            </nav>
          )}
        </div>
      </section>
    )
  }

  <section class="section home-band" aria-labelledby="games-title">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">{h.gamesEyebrow}</p>
          <h2 id="games-title">{h.gamesTitle}</h2>
          <p class="lede">{h.gamesLede}</p>
        </div>
        <a class="btn" href={l('/games/')}>{fill(h.seeAllGames, { count: games.length })} <Icon name="arrow" /></a>
      </div>
      <ul class="card-grid reveal">
        {featured.map((g) => <li><GameCard game={g} lang={lang} /></li>)}
      </ul>
    </div>
  </section>

  <section class="section section--linen" aria-labelledby="how-title">
    <div class="container">
      <div class="section-head">
        <h2 id="how-title">{h.howTitle}</h2>
      </div>
      <ol class="home-steps reveal">
        {
          h.steps.map((step, i) => (
            <li>
              <span class="home-steps__n">{i + 1}</span>
              <h3>{step.title}</h3>
              <p>{step.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section" aria-labelledby="stage-title">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">{h.stageEyebrow}</p>
          <h2 id="stage-title">{h.stageTitle}</h2>
          <p class="lede">{h.stageLede}</p>
        </div>
        <a class="btn" href={l('/activities/ideas/')}>{h.ideas101} <Icon name="arrow" /></a>
      </div>
      <ul class="stage-grid home-stagger reveal">
        {
          h.stages.map((s) => (
            <li>
              <GuideCard href={l(s.href)} title={s.title} text={s.text} label={s.label} lang={lang} />
            </li>
          ))
        }
      </ul>
      <p class="lede" set:html={localizeHtml(lang, h.specificHtml)} />
    </div>
  </section>

  <section class="section section--linen" aria-labelledby="approach-title">
    <div class="container home-approach">
      <div>
        <p class="eyebrow">{h.approachEyebrow}</p>
        <h2 id="approach-title">{h.approachTitle}</h2>
        <p class="lede">{h.approachLede}</p>
        <a class="btn" href={l('/about/')}>{h.approachLink}</a>
      </div>
      <ul class="home-principles reveal">
        {
          h.principles.map((p) => (
            <li>
              <Icon name={p.icon as IconName} />
              <div>
                <h3>{p.title}</h3>
                <p>{p.text}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section" aria-labelledby="guides-title">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">{h.guidesEyebrow}</p>
          <h2 id="guides-title">{h.guidesTitle}</h2>
        </div>
        <a class="btn" href={l('/caregiving/')}>{h.allCaregiving} <Icon name="arrow" /></a>
      </div>
      <ul class="card-grid reveal">
        {h.guides.map((g) => <li><GuideCard href={l(g.href)} title={g.title} text={g.text} lang={lang} /></li>)}
      </ul>
      {lang === 'en' && (
        <aside class="home-research reveal" aria-labelledby="today-band">
          <div>
            <h2 id="today-band">What is hardest today?</h2>
            <p>Pick the hard moment, such as asking to go home or a restless late afternoon. Get three things to try, when to get help and one gentle activity, and keep private notes to print for an appointment.</p>
          </div>
          <a class="btn" href="/today/">Start with today</a>
        </aside>
      )}
      <aside class="home-research reveal">
        <div>
          <h2>{h.researchTitle}</h2>
          <p>{h.researchText}</p>
        </div>
        <a class="btn" href={l('/brain-health/')}>{h.researchLink}</a>
      </aside>
    </div>
  </section>

  <section class="section home-app" aria-labelledby="app-title">
    <div class="container home-app__inner reveal">
      <div>
        <p class="eyebrow">{h.appEyebrow}</p>
        <h2 id="app-title">{h.appTitle}</h2>
        <p>{h.appText}</p>
        <div class="btn-row">
          <a class="btn" href={SITE.appStoreUrl} rel="noopener"><Icon name="phone" />{t.appCta.appStoreShort}</a>
          <a class="btn" href={playStoreUrl('home')} rel="noopener"><Icon name="phone" />{t.appCta.googlePlayShort}</a>
          <a class="btn btn--quiet" href={l('/app/')}>{h.aboutApp}</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container container--narrow reveal">
      <Faq items={h.faq} lang={lang} />
    </div>
  </section>

  <div class="container"><PlayCta lang={lang} /></div>
</BaseLayout>
