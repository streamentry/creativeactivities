---
/**
 * Crisis-safe route (WEB-061). Shown on pages that invite talk about feelings, grief or loss.
 * All three routes are listed; the page does not guess where the visitor lives.
 * The routes, numbers and check dates live in src/data/crisis-routes.ts.
 */
import { CRISIS_CHECKED_ON, CRISIS_PRINT_LINE, CRISIS_ROUTES } from '../data/crisis-routes';

export const CHECKED_ON = CRISIS_CHECKED_ON;
/** The same routes as the box below, in one line for printed cards (TSA-027). */
export const PRINT_CRISIS_LINE = CRISIS_PRINT_LINE;
---
<aside class="notice crisis-route" aria-labelledby="crisis-route-title">
  <div>
    <strong id="crisis-route-title">If you are in crisis</strong>
    <p>
      If you are thinking about ending your life, hurting yourself, or you feel unsafe right now, contact someone today.
      You do not need to explain why first.
    </p>
    <ul>
      {CRISIS_ROUTES.map((r) => (
        <li><strong>{r.region}:</strong> {r.lead}{r.emphasis !== null && <> <strong>{r.emphasis}</strong></>}{r.tail}</li>
      ))}
    </ul>
    <p class="muted">
      Numbers checked on {CHECKED_ON}. This note does not collect anything you read or type, and it does not assess anyone's
      risk.
    </p>
  </div>
</aside>
