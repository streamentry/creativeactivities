---
/**
 * A retired page's address: sends the reader straight on (meta refresh, the static-site equivalent
 * of a permanent redirect), tells search engines the new address (canonical) and to drop this one
 * (noindex), and shows a plain link for anyone whose browser does not follow the refresh.
 */
interface Props {
  to: string;
  lang: string;
}
const { to, lang } = Astro.props;
const absolute = new URL(to, Astro.site).href;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Creative Activities</title>
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={absolute} />
    <meta http-equiv="refresh" content={`0; url=${to}`} />
  </head>
  <body>
    <p><a href={to}>{absolute}</a></p>
  </body>
</html>
