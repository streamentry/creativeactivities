---
import Icon from './Icon.astro';
import { SITE } from '../lib/site';
import { localePath } from '../i18n/locales';
import { ui } from '../i18n/ui';
import { playStoreUrl, type StorePlacement } from '../lib/store-links';

interface Props {
  title?: string;
  text?: string;
  /** A small box for article and game sidebars instead of a full band. */
  compact?: boolean;
  lang?: string;
  /** Where the box sits, for Play Console's acquisition report. */
  placement?: StorePlacement;
}
const { compact = false, lang = 'en', placement = 'guide' } = Astro.props;
const t = ui(lang).appCta;
const { title = t.title, text = t.text } = Astro.props;
---
{
  compact ? (
    <div class="aside-box app-cta-box">
      <h2>{title}</h2>
      <p class="small-print">{text}</p>
      <div class="app-cta-links">
        <a class="btn btn--primary" href={SITE.appStoreUrl} rel="noopener"><Icon name="phone" />{t.appStoreShort}</a>
        <a class="btn" href={playStoreUrl(placement)} rel="noopener"><Icon name="phone" />{t.googlePlayShort}</a>
      </div>
      <a class="small-print" href={localePath(lang, '/app/')}>{t.about}</a>
    </div>
  ) : (
    <section class="cta-band cta-band--app" aria-label={t.aria}>
      <div>
        <h2>{title}</h2>
        <p>{text}</p>
      </div>
      <div class="btn-row">
        <a class="btn btn--primary btn--hero" href={SITE.appStoreUrl} rel="noopener"><Icon name="phone" />{t.appStore}</a>
        <a class="btn" href={playStoreUrl(placement)} rel="noopener"><Icon name="phone" />{t.googlePlay}</a>
      </div>
    </section>
  )
}

<style>
  .app-cta-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    margin: var(--space-md) 0 var(--space-sm);
  }
  /* A calm paper sheet, not a banner: no glow, one soft sage sheet behind it. */
  .app-cta-box,
  .cta-band--app {
    position: relative;
    background: var(--gm-surface);
    border: 1px solid var(--gm-surface-sunken);
    box-shadow: var(--shadow-hairline);
  }
  .app-cta-box::before,
  .cta-band--app::before {
    content: '';
    position: absolute;
    inset-block: 8px -8px;
    inset-inline: 8px -8px;
    z-index: -1;
    border-radius: inherit;
    background: var(--gm-surface-sunken);
    rotate: 0.8deg;
  }
  .app-cta-box {
    margin-top: var(--space-lg);
  }
  .app-cta-box h2 {
    font-size: var(--text-title-md);
  }
  .cta-band--app {
    margin-top: var(--space-xl);
    background: var(--gm-surface);
    background-image: none;
  }
  .cta-band--app::before {
    inset-block: 10px -10px;
    inset-inline: 10px -10px;
    rotate: -0.6deg;
    background: color-mix(in srgb, var(--gm-primary-container) 30%, var(--gm-surface-sunken));
  }
  @media (prefers-reduced-motion: no-preference) {
    .app-cta-box::before,
    .cta-band--app::before {
      transition: rotate var(--duration-normal) var(--ease-out);
    }
    .app-cta-box:hover::before,
    .cta-band--app:hover::before {
      rotate: 0deg;
    }
  }
  @media print {
    .app-cta-box,
    .cta-band--app {
      box-shadow: none;
    }
    .app-cta-box::before,
    .cta-band--app::before {
      display: none;
    }
  }
  @media (prefers-contrast: more), (forced-colors: active) {
    .app-cta-box::before,
    .cta-band--app::before {
      display: none;
    }
  }
  html[data-contrast='high'] .app-cta-box::before,
  html[data-contrast='high'] .cta-band--app::before {
    display: none;
  }
</style>
