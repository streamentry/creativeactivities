---
import { SITE } from '../lib/site';
import { href as link, localePath } from '../i18n/locales';
import { PUBLISHED, ui } from '../i18n/ui';
import Icon from './Icon.astro';
import { englishPathFor } from '../lib/retired-guides';

interface Props {
  lang?: string;
  /** Languages this page exists in; others link to that language's home. */
  available?: readonly string[];
  /** The page path without a language prefix. */
  path?: string;
}
const { lang = 'en', available = ['en'] } = Astro.props;
// The 404 page has no stable path of its own; its language links go home.
const path = Astro.props.path === '/404/' ? '/' : (Astro.props.path ?? '/');
const t = ui(lang);
const f = t.footer;
const year = new Date(SITE.updated).getFullYear();
const en = lang !== 'en' ? ` ${t.common.englishOnly}` : '';
const current = PUBLISHED.find((l) => l.code === lang) ?? PUBLISHED[0]!;

const columns = [
  {
    title: f.play,
    links: [
      ['/games/picture-pairs/', f.picturePairs],
      ['/games/conversation-cards/', f.conversationCards],
      ['/games/picture-bingo/', f.pictureBingo],
      ['/games/', f.allGames],
      ['/pictures/', f.pictures + en],
    ],
  },
  {
    title: f.activityIdeas,
    links: [
      ['/crafts/', f.crafts],
      ['/kids/', f.kids],
      ['/together/', f.together],
      ['/creative-calm/', f.creativeCalm],
      ['/activities/', f.allActivities],
    ],
  },
  {
    title: f.forCaregivers,
    links: [
      ['/dementia-activities/', f.dementiaActivities + en],
      ['/caregiving/how-to-play-together/', f.playTogether],
      ['/creative-calm/creative-self-care-for-caregivers/', f.selfCare],
      ['/faq/', f.faq],
    ],
  },
  {
    title: f.about,
    links: [
      ['/for-organizations/', f.organizations],
      ['/app/', f.app],
      ['/help/', f.appHelp + en],
      ['/art-therapy-and-creative-activities/', f.artTherapyBoundary + en],
    ],
  },
  // TSA-048: one set of pages that say who runs the site, how content is checked,
  // how data is handled and how to complain.
  {
    title: f.transparency,
    links: [
      ['/about/', f.approach],
      ['/editorial-policy/', f.howWeWrite],
      ['/corrections/', f.corrections + en],
      ['/safety/', f.safety + en],
      ['/accessibility/', f.accessibility + en],
      ['/privacy/', f.sitePrivacy + en],
      ['/your-data/', f.yourData + en],
      ['/terms/', f.terms + en],
      ['/support/', f.support + en],
      ['/corrections/#report-a-problem', f.reportProblem + en],
    ],
  },
  {
    title: f.legal,
    links: [
      ['/privacy/', f.sitePrivacy + en],
      ['/app-privacy/', f.appPrivacy + en],
      ['/privacy-choices/', f.privacyChoices + en],
      ['/terms/', f.terms + en],
      ['/safety/', f.safety + en],
      ['/accessibility/', f.accessibility + en],
      ['/medical-disclaimer/', f.healthNotice + en],
      ['/legal/', f.allLegal + en],
    ],
  },
] as const;
---
<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      {
        columns.map((col) => (
          <div>
            <h2>{col.title}</h2>
            <ul>
              {col.links.map(([p, label]) => (
                <li>
                  <a href={link(lang, p)}>{label}</a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
    {
      PUBLISHED.length > 1 && (
        <details class="lang-menu">
          <summary>
            <h2>{t.common.languages}</h2>
            <span class="lang-menu__current" lang={current.bcp47}>{current.name}</span>
            <Icon name="arrow" size={20} class="lang-menu__chevron" />
          </summary>
          <nav aria-label={t.common.languages}>
            <ul class="lang-menu__grid">
              {PUBLISHED.map((l) => (
                <li>
                  <a
                    href={localePath(l.code, available.includes(l.code) ? (l.code === 'en' ? englishPathFor(path) : path) : '/')}
                    hreflang={l.bcp47}
                    lang={l.bcp47}
                    aria-current={l.code === lang ? 'true' : undefined}
                  >
                    {l.code === lang && <Icon name="check" size={20} />}
                    {l.name}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        </details>
      )
    }
    <div class="footer-note">
      <p>{f.note}</p>
      <p>© {year} {t.common.brandName} · {SITE.domain}</p>
    </div>
  </div>
</footer>
