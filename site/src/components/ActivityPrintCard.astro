---
import type { CollectionEntry } from 'astro:content';
import { SITE } from '../lib/site';
import { PAUSE_LINE, SCOPE_LINE } from '../lib/scope';
import { SAFETY_FLAG_LABELS, TYPE_LABELS, VARIATION_LABELS, glance } from '../lib/activities';
import ActivityImage from './ActivityImage.astro';
import SafetyFlags from './SafetyFlags.astro';
import { CHECKED_ON, PRINT_CRISIS_LINE } from './CrisisRoute.astro';

interface Props {
  activity: CollectionEntry<'activityCards'>;
  /** Which variation to print; "easier" unless the pack is about one need. */
  variation?: string;
  /**
   * Print every variation, each in its own block, with only `variation` showing. The pack builder (WEB-017)
   * uses it so one page can print any version; the fixed packs print the one they name.
   */
  allVariations?: boolean;
}
const { activity, variation = 'easier', allVariations = false } = Astro.props;
const d = activity.data;
const path = `/activity/${activity.id}/`;
const easier = d.variations.find((v) => v.kind === variation) ?? d.variations[0];
const id = `card-${activity.id}`;
// The date of the card's last change: the same version the card's own page and its single print show (WEB-016).
const version = d.updated.toISOString().slice(0, 10);
const resultImages = d.images.filter((image) => image.step === undefined);
const stepImages = (step: number) => d.images.filter((image) => image.step === step);
---
<section class="pack-card" aria-labelledby={id}>
  <p class="eyebrow">{TYPE_LABELS[d.type]}</p>
  <h2 id={id}><a href={path}>{d.name}</a></h2>
  <p class="pack-card__summary">{d.summary}</p>
  <p class="activity-scope">{SCOPE_LINE}</p>
  <p class="activity-glance">
    {glance(d).map((fact) => <span>{fact}</span>)}
    {d.safetyFlags.includes('small-parts') && <span>{SAFETY_FLAG_LABELS['small-parts']}</span>}
  </p>
  <div class="pack-card__columns">
    <div>
      <h3>What you need</h3>
      <ul class="activity-list">{d.materials.map((m) => <li>{m}</li>)}</ul>
    </div>
    {
      allVariations ? (
        <div>
          {d.variations.map((v) => (
            <div data-variation={v.kind} hidden={v.kind !== variation}>
              <h3>{VARIATION_LABELS[v.kind]}</h3>
              <p>{v.text}</p>
            </div>
          ))}
        </div>
      ) : (
        <div>
          <h3>{VARIATION_LABELS[easier.kind]}</h3>
          <p>{easier.text}</p>
        </div>
      )
    }
  </div>
  <h3>What to do</h3>
  {resultImages.map((image) => <ActivityImage image={image} />)}
  <ol class="activity-steps">
    {
      d.steps.map((step, i) => (
        <li>
          {step}
          {stepImages(i + 1).map((image) => <ActivityImage image={image} />)}
        </li>
      ))
    }
  </ol>
  <div class="activity-stop">
    <p><strong>It is okay to stop.</strong> {d.stopNote}</p>
    <p>{PAUSE_LINE}</p>
  </div>
  <h3>Safety</h3>
  <SafetyFlags flags={d.safetyFlags} />
  <ul class="activity-list">{d.safety.map((s) => <li>{s}</li>)}</ul>
  {
    d.crisisRoute && (
      <div class="activity-crisis" data-crisis-route>
        <p><strong>If you are in crisis:</strong> {PRINT_CRISIS_LINE} Numbers checked on {CHECKED_ON}.</p>
      </div>
    )
  }
  <p class="pack-card__source">
    Version {version}. More versions and safety notes: {SITE.domain}{path}. Report a safety problem: {SITE.domain}/corrections/#report-safety. Corrections: {SITE.domain}/corrections/
  </p>
</section>

<style>
/* Crisis route printed on an activity card (TSA-027). */
.activity-crisis {
  margin-top: 0.75rem;
  padding: 0.5rem 0.75rem;
  border: 1px solid var(--gm-outline);
  font-size: 0.9rem;
}
</style>
