---
import BrandMark from './BrandMark.astro';
import { NAV } from '../lib/site';
import { localePath, splitLocale } from '../i18n/locales';
import { ui } from '../i18n/ui';
import TextSize from './TextSize.astro';

interface Props {
  lang?: string;
}
const { lang = 'en' } = Astro.props;
const t = ui(lang);
const path = splitLocale(Astro.url.pathname).path;
---
<header class="site-header">
  <div class="container site-header__inner">
    <a class="brand" href={localePath(lang, "/")}>
      <BrandMark class="brand__mark" />
      <span class="brand__text">
        <span class="brand__name">{t.common.brandName}</span>
        <span class="brand__tag">{t.common.brandTag}</span>
      </span>
    </a>
    <nav class="site-nav" aria-label={t.common.mainNav}>
      <ul>
        {
          NAV.map((item) => (
            <li>
              <a
                href={item.englishOnly ? item.href : localePath(lang, item.href)}
                aria-current={path === item.href ? 'page' : undefined}
                data-active={
                  item.href === '/' ? (path === '/' ? 'true' : undefined) : path.startsWith(item.href) ? 'true' : undefined
                }
              >
                {item.key === 'home' ? t.common.home : t.common.nav[item.key]}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <TextSize lang={lang} />
  </div>
</header>

<script>
  // The header grows with text size, so the space reserved above focused links and sticky asides follows its real height (WCAG 2.4.11).
  // Without script, the CSS values (7rem) apply.
  const header = document.querySelector<HTMLElement>('.site-header');
  if (header && 'ResizeObserver' in window) {
    new ResizeObserver(() => {
      const clear = `${Math.ceil(header.getBoundingClientRect().height) + 16}px`;
      document.documentElement.style.setProperty('--header-clear', clear);
      document.documentElement.style.scrollPaddingTop = clear;
    }).observe(header);
  }
  // Browsers do not scroll to a focused link that is already partly on screen, so one under the header stays hidden.
  // Move the page just enough to bring a focused control below the header.
  document.addEventListener('focusin', (event) => {
    if (!header || !(event.target instanceof HTMLElement) || header.contains(event.target)) return;
    const clearance = header.getBoundingClientRect().bottom + 16;
    const top = event.target.getBoundingClientRect().top;
    if (top < clearance && top > -1000) window.scrollBy(0, top - clearance);
  });
</script>
