---
/**
 * Google Analytics 4 through Google Tag Manager (maintainer decisions:
 * GA4 on 2026-10-25, GTM on 2026-11-13, consent first on 2026-11-15).
 *
 * Nothing from Google loads until a visitor answers "Allow" in the consent
 * bar (ConsentBar.astro) or on the privacy page. "No" is the easy default:
 * no answer, a "No thanks" or no JavaScript all mean no analytics. Consent
 * mode starts all denied and a yes grants analytics storage only; Tag
 * Manager's automatic click, link, form and other listeners and Custom HTML
 * tags are blocklisted in code (lib/consent.ts). A browser sending Global
 * Privacy Control is never counted and never asked. Not rendered on Photo
 * pairs, Scrapbook, Picture puzzle or the kids guides (`analytics={false}`),
 * which keeps a no-third-party policy for family photos and children's pages.
 */
import { SITE } from '../lib/site';
---
<meta name="ca-gtm" content={SITE.gtmContainerId} />
<script>
  import { browserConsentStorage, browserGpc, readConsent, shouldLoadAnalytics } from '../lib/consent';
  import { loadAnalytics } from '../lib/consent-runtime';

  const id = document.querySelector<HTMLMetaElement>('meta[name="ca-gtm"]')?.content ?? '';
  if (shouldLoadAnalytics(readConsent(browserConsentStorage()), browserGpc())) loadAnalytics(id);
</script>
