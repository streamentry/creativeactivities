---
/**
 * WEB-052: the print-only paper version of a game, rendered at build time
 * from a fixed sheet (`src/lib/games/print-sheet.ts`). Hidden on screen
 * (`.sheet`); games.css lays it out for one A4 or US Letter page.
 */
import { pictureShadowUrl, pictureUrl } from '../data/pictures';
import { NUMBER_COLORS } from '../data/color-by-number';
import { PEOPLE_COUNT, TARGET_CENTER, TARGET_SIZE, ringMarks } from '../data/seated-toss';
import type { PlayUi } from '../i18n/play';
import type { PrintSheet } from '../lib/games/print-sheet';

interface Props {
  sheet: PrintSheet;
  title: string;
  /** The game's own guidance line, word for word. */
  rules: string;
  /** How to use the paper version: cut out, point or circle. */
  howTo: string;
  pictureNames: Record<string, string>;
  /** The two basket names, for the sorting sheet. */
  baskets?: readonly [string, string];
  /** Color names by id, for the rows of the Color match sheet. */
  colorNames?: Record<string, string>;
  /** The four color names of Color by number, in the order of the numbers 1 to 4. */
  numberColorNames?: readonly string[];
  /** The words of Seated toss tally: ring names, the two people, the safety line. */
  toss?: PlayUi['seatedToss'];
}

const { sheet, title, rules, howTo, pictureNames, baskets, colorNames, numberColorNames, toss } = Astro.props;
const name = (id: string) => pictureNames[id] ?? '';
const rings = toss ? ringMarks(toss.rings) : [];
---
<section class="sheet sheet-paper" aria-hidden="true">
  <h2>{title}</h2>
  <p class="sheet-paper__rules">{rules}</p>
  <p class="sheet-paper__how">{howTo}</p>
  {
    sheet.layout === 'cards' && (
      <div class="sheet-paper__cards">
        {sheet.pictures.map((id) => (
          <figure>
            <img src={pictureUrl(id)} alt="" width="120" height="120" />
            <figcaption>{name(id)}</figcaption>
          </figure>
        ))}
      </div>
    )
  }
  {
    sheet.layout === 'rows' && (
      <ol class="sheet-paper__rows">
        {sheet.rows.map((row) => (
          <li data-target={row.target ? 'yes' : 'no'} data-color={row.color ? 'yes' : 'no'}>
            {row.color && (
              <p class="sheet-paper__color">
                <span class="sheet-paper__swatch" data-color={row.color} />
                {colorNames?.[row.color] ?? ''}
              </p>
            )}
            {row.target && (
              <figure class="sheet-paper__target" data-shadow={sheet.shadow ? 'yes' : 'no'}>
                <img src={sheet.shadow ? pictureShadowUrl(row.target) : pictureUrl(row.target)} alt="" width="120" height="120" />
              </figure>
            )}
            {row.choices.map((id) => (
              <figure>
                <img src={pictureUrl(id)} alt="" width="120" height="120" />
                <figcaption>{name(id)}</figcaption>
              </figure>
            ))}
          </li>
        ))}
      </ol>
    )
  }
  {
    sheet.layout === 'chain' && (
      <ol class="sheet-paper__chain">
        {sheet.pictures.map((id) => (
          <li>
            <figure>
              <img src={pictureUrl(id)} alt="" width="120" height="120" />
              <figcaption>{name(id)}</figcaption>
            </figure>
          </li>
        ))}
      </ol>
    )
  }
  {
    sheet.layout === 'halves' && (
      <div class="sheet-paper__halves">
        <div class="sheet-paper__halves-column">
          {sheet.pictures.map((id) => (
            <span class="sheet-paper__half sheet-paper__half--left">
              <img src={pictureUrl(id)} alt="" width="120" height="120" />
            </span>
          ))}
        </div>
        <div class="sheet-paper__halves-column">
          {sheet.rightOrder.map((id) => (
            <span class="sheet-paper__half sheet-paper__half--right">
              <img src={pictureUrl(id)} alt="" width="120" height="120" />
            </span>
          ))}
        </div>
      </div>
    )
  }
  {
    sheet.layout === 'grid' && (
      <>
        <ul class="sheet-paper__key">
          {NUMBER_COLORS.map((color) => (
            <li data-fill={color.number}>
              <span class="sheet-paper__key-swatch">
                <span class="cbn__shape" data-shape={color.shape} />
              </span>
              {color.number} {numberColorNames?.[color.number - 1] ?? ''}
            </li>
          ))}
        </ul>
        <div class="sheet-paper__grid" data-size={sheet.size}>
          {sheet.rows.flatMap((row) => row.map((n) => <span class="sheet-paper__cell">{n}</span>))}
        </div>
      </>
    )
  }
  {
    sheet.layout === 'toss' && toss && (
      <>
        <svg class="sheet-paper__target-art" viewBox={`0 0 ${TARGET_SIZE} ${TARGET_SIZE}`} focusable="false">
          {rings.map((ring) => <circle class="sheet-paper__ring" data-ring={ring.id} cx={TARGET_CENTER} cy={TARGET_CENTER} r={ring.radius} />)}
          {
            rings.map((ring) => (
              <>
                <text class="sheet-paper__ring-name" x={TARGET_CENTER} y={ring.nameY} text-anchor="middle">{ring.name}</text>
                <text class="sheet-paper__ring-name" x={TARGET_CENTER} y={ring.nameY} text-anchor="middle" transform={`rotate(180 ${TARGET_CENTER} ${TARGET_CENTER})`}>{ring.name}</text>
              </>
            ))
          }
        </svg>
        <table class="sheet-paper__tally">
          <thead>
            <tr>
              <th scope="col">{toss.ringHeading}</th>
              {toss.people.slice(0, PEOPLE_COUNT).map((person) => <th scope="col">{person}</th>)}
            </tr>
          </thead>
          <tbody>
            {
              rings.map((ring) => (
                <tr>
                  <th scope="row">{ring.name}</th>
                  {toss.people.slice(0, PEOPLE_COUNT).map(() => <td>{Array.from({ length: sheet.boxes }, () => <span class="sheet-paper__box" />)}</td>)}
                </tr>
              ))
            }
          </tbody>
        </table>
        <p class="sheet-paper__safety"><strong>{toss.safetyHeading}.</strong> {toss.safetyLine}</p>
      </>
    )
  }
  {
    sheet.layout === 'sort' && (
      <>
        <div class="sheet-paper__cards">
          {sheet.pictures.map((id) => (
            <figure>
              <img src={pictureUrl(id)} alt="" width="120" height="120" />
              <figcaption>{name(id)}</figcaption>
            </figure>
          ))}
        </div>
        <div class="sheet-paper__baskets">
          {(baskets ?? ['', '']).map((b) => <div><span>{b}</span></div>)}
        </div>
      </>
    )
  }
  {
    sheet.layout === 'puzzle' && (
      <div class="sheet-paper__puzzle">
        <figure class="sheet-paper__guide">
          <img src={pictureUrl(sheet.picture)} alt="" width="120" height="120" />
          <figcaption>{name(sheet.picture)}</figcaption>
        </figure>
        <div class="sheet-paper__pieces">
          <img src={pictureUrl(sheet.picture)} alt="" width="120" height="120" />
          <span class="sheet-paper__cut" data-cut="across" />
          <span class="sheet-paper__cut" data-cut="down" />
        </div>
      </div>
    )
  }
  <slot />
</section>
