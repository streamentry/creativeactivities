{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://creativeactivities.org/schemas/content-bundle.v1.json",
  "title": "Creative Activities content bundle, version 1",
  "description": "One versioned file per release that the web and the app both read. Built from the activity cards by site/scripts/content-bundle.mjs (PLAT-035).",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "generated", "translationNote", "activities"],
  "properties": {
    "schema": { "const": "creative-activities/content-bundle" },
    "version": { "const": 1 },
    "generated": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "translationNote": { "type": "string", "minLength": 1 },
    "activities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id", "status", "title", "summary", "steps", "materials", "safetyFlags", "safety", "stopNote",
          "variations", "pictures", "review", "published", "updated", "languages", "surfaces"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
          "status": { "enum": ["listed", "withdrawn"] },
          "title": { "type": "string", "minLength": 1, "maxLength": 60 },
          "summary": { "type": "string", "minLength": 1 },
          "steps": { "type": "array", "minItems": 3, "maxItems": 9, "items": { "type": "string", "minLength": 1 } },
          "plainSteps": { "type": "array", "minItems": 3, "maxItems": 16, "items": { "type": "string", "minLength": 1 } },
          "materials": { "type": "array", "minItems": 1, "maxItems": 10, "items": { "type": "string", "minLength": 1 } },
          "safetyFlags": {
            "type": "array",
            "minItems": 1,
            "items": {
              "enum": ["small-parts", "sharp-tool", "heat", "adhesive", "skin-contact", "allergen", "ingestion", "water", "fall-risk", "none"]
            }
          },
          "safety": { "type": "array", "minItems": 1, "maxItems": 6, "items": { "type": "string", "minLength": 1 } },
          "stopNote": { "type": "string", "minLength": 1 },
          "variations": {
            "type": "array",
            "minItems": 2,
            "maxItems": 6,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "text"],
              "properties": {
                "kind": {
                  "enum": [
                    "easier", "less-sensory", "seated", "bedside", "more-collaborative",
                    "for-a-group", "with-children", "low-vision", "nonverbal", "large-grip"
                  ]
                },
                "text": { "type": "string", "minLength": 1, "maxLength": 260 }
              }
            }
          },
          "pictures": { "type": "array", "maxItems": 6, "items": { "type": "string", "pattern": "^/pictures/[a-z0-9-]+\\.svg$" } },
          "review": {
            "oneOf": [
              { "type": "null" },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["name", "role", "credential", "date"],
                "properties": {
                  "name": { "type": "string", "minLength": 2 },
                  "role": {
                    "enum": [
                      "art-therapist", "music-therapist", "psychologist-or-counsellor", "grief-practitioner",
                      "occupational-therapist", "dementia-specialist", "early-years-educator",
                      "lived-experience", "other-credentialed"
                    ]
                  },
                  "credential": { "type": "string", "minLength": 2 },
                  "body": { "type": "string", "minLength": 2 },
                  "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
                }
              }
            ]
          },
          "published": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "updated": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "languages": {
            "type": "object",
            "required": ["en"],
            "propertyNames": { "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]+)*$" },
            "additionalProperties": { "type": "string", "minLength": 1 }
          },
          "surfaces": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "enum": ["web-card", "large-print", "print"] }
          }
        }
      }
    }
  }
}
