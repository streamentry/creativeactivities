/*
  # no-transform stops Cloudflare from injecting scripts (such as its Web
  # Analytics beacon) or rewriting pages. The only analytics is Google
  # Analytics 4, loaded by src/components/Analytics.astro.
  Cache-Control: public, max-age=0, must-revalidate, no-transform
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin
  # Works with the hash-based meta CSP Astro emits (browsers apply both, so a
  # script must pass both). Scripts run only from this site, from Google Tag
  # Manager, or inline when their hash is listed: no 'unsafe-inline' for scripts.
  # The hashes are the inline module scripts Astro writes into every page; they
  # are checked against the built pages by scripts/check-site.mjs, which fails
  # the build when they drift. style-src keeps 'unsafe-inline' because Astro
  # inlines component CSS. This header blocks any network destination except this
  # site and the Google Analytics endpoints Google documents for GA4.
  Content-Security-Policy: default-src 'self'; script-src 'self' 'sha256-0O7iB6zr9x0r6X6eWYITC9V5q+yWCGAoFvcysBGbY9Q=' 'sha256-1BvDVWLr3QCC20uHhUDi27eDFVJpk1uMQJGIWKUks2I=' 'sha256-At4sXbunobuxXv56+YxR7rwL4c3n8ubyPDiI7CIowSo=' 'sha256-KqMmGjE27DGT/t1Q8rSbxS9ycaYzaOaYFyvlRiiHkFI=' 'sha256-S2VdhHGZX/7Piq8r4YT9/Oeo2oHt5BEyA5zO/bs49+I=' 'sha256-UIrFqcaitjA3OKa9mHKajg3N+0Y7tW9+y0o3QmMFeZQ=' 'sha256-Y8t0ntteBwH+PqGKUyjWW3CAk+BNJKSoQc0xZ68FjhM=' 'sha256-wMpTOq4XMJsPQkOhJ014s/K6gn/olK57lVbRbdvCqHA=' 'sha256-ecW7wRTjWL3P8TKMB7rf/BKsLKvnaJa0YO7gzyU05ks=' 'sha256-kmZE/W8I1iuTnl1b3yqzv9/DQZenPngd3NjSKMQl7y0=' 'sha256-xIb/Pa7FUshAu4ihwjchYcQpyCI8eS8kt40GpOAYCz8=' https://www.googletagmanager.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://*.google-analytics.com https://*.googletagmanager.com; font-src 'self'; connect-src 'self' https://*.google-analytics.com https://*.analytics.google.com https://*.googletagmanager.com; media-src 'self'; manifest-src 'self'; worker-src 'none'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests

