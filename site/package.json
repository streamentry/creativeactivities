{
  "name": "creative-activities-site",
  "private": true,
  "type": "module",
  "description": "creativeactivities.org: creative activities to do together, gentle browser games and caregiver guides",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "gen:redirects": "node scripts/gen-redirects.ts",
    "preview": "wrangler dev",
    "check:site": "node --max-old-space-size=6144 scripts/check-site.mjs",
    "check:structured-data": "node scripts/check-structured-data.mjs",
    "check:budget": "node --max-old-space-size=6144 scripts/check-budget.mjs",
    "check:images": "node --max-old-space-size=6144 scripts/check-images.mjs",
    "check:capacity": "node scripts/check-capacity.mjs",
    "check:duplicates": "node --max-old-space-size=6144 scripts/check-duplicates.mjs",
    "check:orphans": "node --max-old-space-size=6144 scripts/check-orphans.mjs",
    "check:print": "node scripts/check-print.mjs",
    "check:visual": "node scripts/check-visual.mjs",
    "check:a11y": "node scripts/a11y-check.mjs",
    "check:browsers": "node scripts/check-browsers.mjs",
    "check:group": "node scripts/check-group-stage.mjs",
    "check:determinism": "node scripts/check-determinism.mjs",
    "build:baseline": "node scripts/build-baseline.mjs",
    "check:live": "node scripts/verify-live-legal.mjs",
    "review:queue": "node scripts/review-queue.mjs",
    "review:plain": "node scripts/plain-language.mjs",
    "indexnow": "node scripts/indexnow.mjs",
    "test": "vitest run",
    "verify": "vitest run && astro build && node --max-old-space-size=6144 scripts/check-site.mjs && node --max-old-space-size=6144 scripts/check-budget.mjs",
    "deploy": "astro build && node --max-old-space-size=6144 scripts/check-site.mjs && wrangler deploy",
    "library:inventory": "node scripts/library-inventory.mjs",
    "translations:queue": "node scripts/translation-queue.mjs",
    "metrics:content": "node scripts/content-metrics.mjs",
    "content:bundle": "node scripts/content-bundle.mjs",
    "content:diff": "node scripts/content-diff.mjs"
  },
  "dependencies": {
    "@astrojs/react": "7.1.0",
    "@tanstack/react-store": "0.11.2",
    "astro": "7.4.7",
    "qrcode-generator": "1.4.4",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.11.1",
      "onFail": "download"
    }
  },
  "devDependencies": {
    "@resvg/resvg-js": "2.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "axe-core": "4.14.0",
    "playwright": "1.56.1",
    "typescript": "6.0.3",
    "vitest": "5.0.4",
    "wrangler": "4.151.1"
  }
}
